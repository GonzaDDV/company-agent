# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key

# Agent Database (new Supabase project for the agent's knowledge store)
AGENT_SUPABASE_URL=https://your-agent-project.supabase.co
AGENT_SUPABASE_SERVICE_ROLE_KEY=your-agent-service-role-key

# Patagon Database (existing Patagon Supabase, read-only access)
PATAGON_SUPABASE_URL=https://your-patagon-project.supabase.co
PATAGON_SUPABASE_SERVICE_ROLE_KEY=your-patagon-service-role-key

# Monday.com CRM (Phase 2 — leave empty for now)
# MONDAY_API_TOKEN=your-monday-api-token

# Proactive Digests — Telegram chat ID where scheduled messages are sent
# Can be a group chat ID (e.g., -1001234567890) or a user's chat ID
 DIGEST_CHAT_ID=your-telegram-chat-id
